# platform-api — variáveis de ambiente locais (desenvolvimento).
#   cp services/platform-api/.env.example services/platform-api/.env
# Gere os segredos localmente; NUNCA versione valores reais:
#   openssl rand -base64 48   (JWT_ACCESS_SECRET, SERVICE_TOKEN_SECRET, PSEUDONYM_KEY)
#   openssl rand -base64 32   (DATA_ENCRYPTION_KEY — exatamente 32 bytes)
# Requer a infra de apoio no ar (infra/compose/dev.yml). Schema relacional: "platform".

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

DATABASE_URL=postgresql://ecosfera:change-me@localhost:5432/ecosfera
DB_LOGGING=false
REDIS_URL=redis://:change-me@localhost:6379

JWT_ACCESS_SECRET=
SERVICE_TOKEN_SECRET=
DATA_ENCRYPTION_KEY=
PSEUDONYM_KEY=

# Adaptadores: fake (só dev/teste; proibido em produção) | http/s3/disabled (reais)
ADAPTER_SIMULATION=fake
ADAPTER_TUTOR=fake
ADAPTER_MAILER=fake
ADAPTER_STORAGE=s3
# AI_SIM_BASE_URL=http://localhost:8000

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ecosfera
S3_SECRET_KEY=change-me
S3_BUCKET_EXPORTS=exports
S3_BUCKET_DATASETS=datasets
SIGNED_URL_TTL_SECONDS=300

# Observabilidade (opcional): coletor OTLP próprio da implantação
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# METRICS_TOKEN=

RETENTION_JOB_ENABLED=false
