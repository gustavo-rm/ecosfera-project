# Copie para .env e ajuste. Prefixo ECOSFERA_ (ver config/settings.py).
ECOSFERA_ENVIRONMENT=dev
ECOSFERA_LOG_LEVEL=INFO
ECOSFERA_LOG_JSON=false
ECOSFERA_CAUSAL_RULES_PATH=configs/causal_rules.yaml
# Ligado só no Incremento 6 (tutor LLM+RAG)
ECOSFERA_LLM_ENABLED=false
ECOSFERA_OLLAMA_BASE_URL=http://localhost:11434
ECOSFERA_LLM_MODEL=llama3
