# Copie para .env e ajuste. Prefixo ECOSFERA_ (ver config/settings.py).
ECOSFERA_ENVIRONMENT=dev
ECOSFERA_LOG_LEVEL=INFO
ECOSFERA_LOG_JSON=false
ECOSFERA_CAUSAL_RULES_PATH=configs/causal_rules.yaml
ECOSFERA_SIMULATION_PARAMS_PATH=configs/simulation_params.yaml
# Persistência do planeta: inmemory (default, sem banco) | postgres (exige --extra infra)
ECOSFERA_PERSISTENCE_BACKEND=inmemory
# Camada emergente (Inc 3): evolução (AG) e ecologia (ABM)
ECOSFERA_BIOLOGY_ENABLED=true
# Fila do job pesado de evolução: inline (dev/testes) | arq (Redis, produção)
ECOSFERA_JOB_BACKEND=inline
ECOSFERA_REDIS_DSN=redis://localhost:6379
ECOSFERA_DATABASE_URL=postgresql+asyncpg://ecosfera:ecosfera@localhost:5432/ecosfera
# Usada pelo Alembic (migrations/env.py). Aceita URL síncrona ou asyncpg.
DATABASE_URL=postgresql+asyncpg://ecosfera:ecosfera@localhost:5432/ecosfera
# Ligado só no Incremento 6 (tutor LLM+RAG)
ECOSFERA_LLM_ENABLED=false
ECOSFERA_OLLAMA_BASE_URL=http://localhost:11434
ECOSFERA_LLM_MODEL=llama3
