# ai-sim-service — variáveis de ambiente locais.
# cp services/ai-sim-service/.env.example services/ai-sim-service/.env
#
# Requer a infra de apoio no ar (ver infra/compose/dev.yml).
# O schema relacional deste serviço é "rag" (ver migrations/env.py).

DATABASE_URL=postgresql://ecosfera:change-me@localhost:5432/ecosfera

# MONGO_URI e REDIS_URL ainda não são lidos por nenhum código (pymongo/redis já
# são dependências do projeto para os repositórios de simulation/tutor, ver
# docs/adr/0001) — mantidos aqui como referência para quando essa infraestrutura
# passar a ser consumida.
# MONGO_URI=mongodb://ecosfera:change-me@localhost:27017/ecosfera?authSource=admin
# REDIS_URL=redis://:change-me@localhost:6379/0
