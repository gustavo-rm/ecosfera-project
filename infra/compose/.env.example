# ECOSFERA — variáveis de ambiente para infra/compose/dev.yml
#
# Uso:
#   cp infra/compose/.env.example infra/compose/.env   # e edite as senhas
#   docker compose -f infra/compose/dev.yml --env-file infra/compose/.env up -d

# ── PostgreSQL (+pgvector) ───────────────────────────────────────────────────
POSTGRES_USER=ecosfera
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecosfera
POSTGRES_PORT=5432

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USER=ecosfera
MONGO_PASSWORD=change-me
MONGO_DB=ecosfera
MONGO_PORT=27017

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=ecosfera
MINIO_ROOT_PASSWORD=change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_PORT=11434
