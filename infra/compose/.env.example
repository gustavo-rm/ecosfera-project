# ECOSFERA — variáveis da infra de desenvolvimento.
# Copie para infra/compose/.env e troque TODAS as senhas.
# NUNCA commite o arquivo .env (apenas este .example).

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=ecosfera
POSTGRES_PASSWORD=troque-esta-senha-postgres
POSTGRES_DB=ecosfera
POSTGRES_PORT=5432

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USER=ecosfera
MONGO_PASSWORD=troque-esta-senha-mongo
MONGO_DB=ecosfera
MONGO_PORT=27017

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=troque-esta-senha-redis
REDIS_PORT=6379

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=ecosfera
MINIO_ROOT_PASSWORD=troque-esta-senha-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_PORT=11434

# ─────────────────────────────────────────────────────────────────────────────
# Connection strings usadas PELOS SERVIÇOS (derivadas do acima).
# Coloque no .env de cada serviço; o schema do Postgres é escolhido por serviço.
#
# platform-api (schema "platform", via TypeORM — schema é definido no data-source):
#   DATABASE_URL=postgres://ecosfera:troque-esta-senha-postgres@localhost:5432/ecosfera
#
# ai-sim-service (schema "rag"):
#   DATABASE_URL=postgresql+psycopg://ecosfera:troque-esta-senha-postgres@localhost:5432/ecosfera
#   MONGO_URL=mongodb://ecosfera:troque-esta-senha-mongo@localhost:27017/ecosfera?authSource=admin
#   REDIS_URL=redis://:troque-esta-senha-redis@localhost:6379/0
#   OLLAMA_URL=http://localhost:11434
# ─────────────────────────────────────────────────────────────────────────────
